<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screenshot ingest (sideload phase; Play declaration prepared per docs/store) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ partial access: user-selected screenshots only -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK: WorkManager holds brief locks while OCR jobs run -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The privacy claim, enforced structurally: no code path in this process —
         ours or any library's — can transmit anything, because the permission is
         stripped even if a dependency's manifest requests it. Calendar entries
         use ACTION_INSERT (no permission needed); camera/FGS/boot return only
         when the module that uses them ships. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Backup off: OCR-derived text, codes, and screenshot copies must not
         leave the device via platform backup either. -->
    <application
        android:name=".ShotlistApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shotlist"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Shotlist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet ingest: the store-compliant fallback path -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".actions.ShotlistReminderReceiver"
            android:exported="false" />
    </application>
</manifest>
